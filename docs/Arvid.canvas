		{"id":"root","type":"text","text":"### 🌲 Waldhüter Arvid (Start)\n\n> „Ach du Scheiße, was willst du denn hier?“\n\n*Hüter der Schutzhütte*","x":220,"y":0,"width":360,"height":140,"color":"3"},
		{"id":"arvid_zinsbachtal","type":"text","text":"### 🌲 Waldhüter Arvid\n\n> „Zinsbachtal, Ja, ich erinnere mich. Da war es schön. Damals.“","x":-200,"y":280,"width":320,"height":140,"color":"5"},
		{"id":"arvid_penner","type":"text","text":"### 🌲 Waldhüter Arvid\n\n> „Ein Satz heiße Ohren gefällig?“","x":680,"y":280,"width":320,"height":140,"color":"5"},
		{"id":"arvid_bier","type":"text","text":"### 🌲 Waldhüter Arvid\n\n> „Macht ein Euro!“","x":240,"y":280,"width":320,"height":140,"color":"5"},
		{"id":"6ddf53f938027555","x":-380,"y":480,"width":283,"height":94,"color":"1","type":"text","text":"Wie, damals? Nach meiner Karte ist es nur noch ein Katzensprung"},
		{"id":"fbde544d83d5985a","x":-81,"y":484,"width":250,"height":60,"color":"1","type":"text","text":"Ja ja, früher war alles besser. Ich weiß."},
		{"id":"30be59c1316ff318","x":220,"y":484,"width":250,"height":60,"color":"1","type":"text","text":"Ein Schnäppchen, her damit!"},
		{"id":"bf8c284075e01e32","x":396,"y":498,"width":250,"height":60,"color":"1","type":"text","text":"Was gibts denn für ne Sorte?"},
		{"id":"66c32247c37edb3d","x":628,"y":486,"width":250,"height":60,"color":"1","type":"text","text":"Große Worte für ein Stück Gammelfleisch."},
		{"id":"dc86ada276dc07bb","x":848,"y":499,"width":250,"height":60,"color":"1","type":"text","text":"War nicht so gemeint. Hast du ein Bier über?"}
	],
